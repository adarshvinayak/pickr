# Required: never put service keys into frontend/native assets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Google Maps Platform. Server key: enable Places API (New), Geocoding API and Routes API; restrict by API (and IP if your host has fixed IPs).
GOOGLE_MAPS_SERVER_KEY=your-google-server-key
# Browser-visible key: enable Maps JavaScript API only; restrict to approved websites incl. https://appassets.androidplatform.net (Android app).
GOOGLE_MAPS_WEB_KEY=your-google-web-key
# Migration/setup access only. Copy direct or Session pooler URI from Supabase Connect.
# Include database password; percent-encode reserved password characters. Avoid port 6543.
DATABASE_URL=
# Optional trusted CA certificate path if PostgreSQL TLS requires a custom root.
DATABASE_SSL_CA_FILE=
# Google routing is general traffic-aware driving: it does not apply truck dimensions or avoid reported closures.

# Bootstrap first admin only; after creation password edits are stored hashed in the database.
ADMIN_BOOTSTRAP_PHONE=your-10-digit-mobile
ADMIN_BOOTSTRAP_PASSWORD=choose-a-long-private-password
# Public origin of the web backend (LAN URL locally, HTTPS URL on Render).
PUBLIC_APP_URL=http://localhost:3000
# Optional APK default URL. Otherwise build uses PUBLIC_APP_URL or auto-detected LAN IP.
PICKR_BACKEND_URL=
QUOTE_SIGNING_SECRET=replace-with-a-long-random-secret
WORKER_SECRET=replace-with-another-long-random-secret

# Optional: multilingual voice understanding. English rule parsing works without this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Voice booking agent (Gemini Live). Same GEMINI_API_KEY; it stays on the server and the app only receives short-lived tokens.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Optional: one-line service account JSON. For remote push, also add Android google-services.json.
FIREBASE_SERVICE_ACCOUNT_JSON=
