{
  "expo": {
    "name": "pickr",
    "slug": "pickr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pickr",
    "userInterfaceStyle": "light",
    "backgroundColor": "#05090E",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "in.pickr.pilot.customer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.pickr.pilot.customer"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05090E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pickr uses your photos to set your profile picture.",
          "cameraPermission": "PICKR uses your camera for profile and transit-pass photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pickr shows your current area on Home. Pickup and delivery sites are always chosen separately."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "PICKR uses the microphone so you can book a truck by speaking.",
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/customer-app"
    }
  }
}
