# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Native builds, local credentials and delivery artifacts
/native/android/.gradle/
/native/android/build/
/native/android/app/build/
/native/android/app/src/main/assets/public/
/native/android/local.properties
/native/android/app/google-services.json
/artifacts/
.android-tools/
!.env.local.example

/.local-certs/

/.local-tests/

# Separate reference clone and generated Expo web export
/pickrapp-new-build/
/apps/customer/node_modules/
/apps/customer/.expo/
/apps/customer/dist/
/public/customer-app/
