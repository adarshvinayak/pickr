{
  "name": "pickr-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "web": "next dev",
    "build": "npm run customer:export && next build",
    "start": "next start",
    "lint": "eslint src tests native/web native/vite.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:bundle": "vite build --config native/vite.config.mts",
    "android:build": "sh scripts/build-android.sh",
    "test:db": "python3 scripts/test-database.py",
    "test:setup": "node scripts/test-setup-database.mjs",
    "pilot:setup": "node scripts/pilot-setup.mjs",
    "pilot:start": "node scripts/pilot-start.mjs",
    "worker": "node --env-file=.env.local scripts/push-worker.mjs",
    "customer:export": "node scripts/export-customer.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@supabase/supabase-js": "^2.48.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/google.maps": "^3.67.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
